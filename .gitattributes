# Preserve generated image arrays exactly as emitted by their asset tooling.
examples/factory/components/**/assets/** whitespace=-trailing-space
examples/factory/archive/components/**/assets/** whitespace=-trailing-space

# Keep embedded xiaozhi_esp32 sources byte-for-byte compatible with their upstream copy.
examples/factory/**/xiaozhi_esp32/** whitespace=-trailing-space

# This SquareLine Studio output is regenerated from its UI project.
examples/factory/components/brookesia_core/systems/speaker/widgets/quick_settings/ui/ui_comp_quicksettings.c whitespace=-trailing-space

# Bundled Arduino libraries and this upstream-derived LVGL configuration retain upstream whitespace.
examples/arduino/libraries/** whitespace=-trailing-space,-space-before-tab
examples/arduino/libraries/lv_conf.h whitespace=-trailing-space

# Flash images and fonts contain raw bytes, including long erased-flash regions.
*.bin -diff -text
*.mp3 -diff -text
*.wav -diff -text
*.ogg -diff -text
